# Aucune vraie valeur ici.
# Sous WordPress ces valeurs vont en constantes dans wp-config.php (jamais commitées, jamais dans le thème/plugin).

# Stripe (mode test d'abord)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CBOT=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# n8n (webhooks signés dans les deux sens)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Licences : la clé PRIVÉE reste côté n8n/serveur de licences, pas dans WordPress.
# Seule la clé publique est utile au site (affichage/vérification) et au cBot.
LICENSE_PUBLIC_KEY=

# Emails (SMTP de l'hébergeur ou autre)
EMAIL_FROM=
